# Server
PORT=5443
NODE_ENV=development
# Comma-separated list of allowed browser origins (Vite dev server by default)
CLIENT_ORIGIN=http://localhost:5173

# JWT  (generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
JWT_SECRET=replace_this_with_a_long_random_secret
JWT_EXPIRES_IN=1h

# HTTPS (self-signed for local dev - see certs/README.md)
SSL_KEY_PATH=./certs/key.pem
SSL_CERT_PATH=./certs/cert.pem

# Rate limiting
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20
BOOKING_RATE_LIMIT_WINDOW_MS=600000
BOOKING_RATE_LIMIT_MAX=10
API_RATE_LIMIT_WINDOW_MS=900000
API_RATE_LIMIT_MAX=300

# Income / tax estimate (illustrative flat rate, NOT tax advice)
TAX_RATE=0.15
CURRENCY=ZAR

# Admin account created by: npm run seed:admin   (CHANGE THE PASSWORD)
ADMIN_EMAIL=admin@hustlehub.local
ADMIN_PASSWORD=AdminPass123
