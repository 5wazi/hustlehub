{
  "name": "hustlehub",
  "version": "2.0.0",
  "description": "HustleHub - secure freelance marketplace (Part 2: full-stack MERN-style app)",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "seed:admin": "node scripts/seedAdmin.js",
    "client:install": "npm --prefix client install",
    "client:build": "npm --prefix client run build",
    "test:client": "npm --prefix client test",
    "test:api": "newman run postman/HustleHub.postman_collection.json --insecure -r cli,htmlextra --reporter-htmlextra-export reports/newman-report.html",
    "test:ratelimit": "node scripts/rateLimitCheck.js"
  },
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "express-validator": "^7.2.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0"
  },
  "devDependencies": {
     "newman": "^6.2.1",
     "newman-reporter-htmlextra": "^1.23.1",
     "nodemon": "^3.1.4"
   },
  "engines": {
    "node": ">=18.0.0"
  }
}
